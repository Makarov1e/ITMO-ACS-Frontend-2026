{
  "name": "tabletime-lab2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Учебная ЛР2 TableTime: fetch, JSON Server и локальная JWT-авторизация",
  "scripts": {
    "api": "PORT=3002 HOST=127.0.0.1 node api/server.mjs",
    "web": "vite --host 0.0.0.0 --port 5172 --strictPort",
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run api\" \"npm run web\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5172 --strictPort",
    "reset-db": "node scripts/reset-db.mjs",
    "test": "node --test tests/api.test.mjs",
    "test:e2e": "node --test tests/browser.e2e.test.mjs",
    "test:a11y": "node --test tests/a11y.e2e.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "bootstrap": "^5.3.8",
    "jsonwebtoken": "^9.0.2",
    "json-server": "0.17.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.55.0",
    "vite": "^7.1.7"
  }
}
